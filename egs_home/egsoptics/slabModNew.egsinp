###############################################################################
#
#  An simple slab input file for tutor4pp.
#
###############################################################################


#==============================================================================
# Run control
#==============================================================================
:start run control:
    ncase = 1
:stop run control:

#==============================================================================
# Geometry
#==============================================================================
:start geometry definition:

    ### plate
    :start geometry:
        name     = slab
        library  = egs_ndgeometry
        type     = EGS_XYZGeometry
        x-planes = -5, 5                         # in cm
        y-planes = -5, 5                         # in cm
        z-planes = -10, 0, 0.1, 1.0, 10          # in cm
        :start media input:
            media = vacuum tantalum scintillator glass
            set medium = 1 1 
            set medium = 2 2
            set medium = 3 3
        :stop media input:

        set label = scint 2
    :stop geometry:

    ### use this geometry for the simulation
    simulation geometry = slab

:stop geometry definition:

#==============================================================================
# Media
#==============================================================================
:start media definition:

    ### cutoff energies
    ae  = 0.521
    ap  = 0.010
    ue  = 50.511
    up  = 50

    ### tantalum
    :start tantalum:
        density correction file = tantalum
    :stop tantalum:

    ### lead
    :start lead:
        density correction file = lead
    :stop lead:

    ### water
    :start water:
        density correction file = water_liquid
    :stop water:

    ### scintillator
    :start scintillator:
        density correction file = sodiumiodide
    :stop scintillator:

    ### glass
    :start glass:
        density correction file = glass_borosilicate__pyrex__corning7740
    :stop glass:

:stop media definition:

#==============================================================================
# Source
#==============================================================================
:start source definition:

    ### pencil beam
    :start source:
        name      = pencil_beam
        library   = egs_parallel_beam
        charge    = -1
        direction = 0 0 1
        :start spectrum:
            type = monoenergetic
            energy = 20                     # in MeV
        :stop spectrum:
        :start shape:
            type     = point
            position = 0 0 -10
        :stop shape:
    :stop source:

    ### use this source for the simulation
    simulation source = pencil_beam

:stop source definition:

#==============================================================================
# Viewer control
#==============================================================================
:start view control:
    set color = lead      120 120 200 200
    set color = tantalum  120 255 120 255
    set color = water       0 220 255 200
    set color = glass       0   0 255 255
:stop view control:

#==============================================================================
# Ausgab objects
#==============================================================================
:start ausgab object definition:

    ### particle tracks
    :start ausgab object:
        name    = tracks
        library = egs_track_scoring
    :stop ausgab object:

    :start pmt:
        name = mypmt
        library = egs_pmt_scoring
        detector regions = myregions
        output file = myoutput.txt
        activity = 1.5
        dead time = 6e-3
        detector resolution = 0.5 # cm
    :stop pmt:

    ### particles that interact in PMT
    :start interaction:
        name = regionCounter
        library = egs_track_scoring
        region = 2
        particle type = photon
    :stop interaction:

    ### testing optics ausgab
    :start ausgab object:
        name = optics_test
        library = egsoptics
        scint_region = 2
        min_edep = 0
        birksCst = 0.126
        scintEff = 10000
    :stop ausgab object:

:stop ausgab object definition:
